        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "100 * sum(rate(order_requests_total{http_status=~\"5..\"}[1m])) / clamp_min(sum(rate(order_requests_total[1m])), 1e-9)",
          "legendFormat": "5xx",
          "refId": "A"
