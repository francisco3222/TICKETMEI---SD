          "expr": "100 * sum(rate(order_requests_total{http_status=~\"4..\"}[1m])) / clamp_min(sum(rate(order_requests_total[1m])), 1e-9)",
          "legendFormat": "4xx",
          "refId": "B"
        }
      ]
    },
